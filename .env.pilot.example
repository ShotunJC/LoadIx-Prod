# Dedicated-server pilot environment. Copy this file to the server's protected
# path (for example /etc/loadix/pilot.env), set mode 0600, and never commit the
# populated file. Values below are placeholders; use a secret manager or an
# operator-controlled protected file for real credentials.
LOADIX_IMAGE_REGISTRY=ghcr.io/replace-owner/replace-repository
LOADIX_IMAGE_TAG=replace-with-40-character-commit-sha
LOADIX_DOMAIN=pilot.example.com
LOADIX_ACME_EMAIL=ops@example.com
LOADIX_WEB_ORIGIN=https://pilot.example.com
LOADIX_ALLOWED_HOSTS=pilot.example.com;api

# Use a certificate-validating SQL endpoint. Do not use TrustServerCertificate=True.
LOADIX_DATABASE_CONNECTION_STRING=
LOADIX_REDIS_HOST=
LOADIX_REDIS_PORT=6380
LOADIX_RABBITMQ_HOST=
LOADIX_RABBITMQ_PORT=5671
LOADIX_RABBITMQ_USERNAME=
LOADIX_RABBITMQ_PASSWORD=
LOADIX_RABBITMQ_VHOST=/loadix
LOADIX_RABBITMQ_USE_SSL=true
LOADIX_RABBITMQ_SERVER_NAME=

LOADIX_OBJECT_STORAGE_HOST=
LOADIX_OBJECT_STORAGE_PORT=443
LOADIX_OBJECT_STORAGE_ENDPOINT=
LOADIX_OBJECT_STORAGE_ACCESS_KEY=
LOADIX_OBJECT_STORAGE_SECRET_KEY=
LOADIX_OBJECT_STORAGE_USE_SSL=true
LOADIX_DOCUMENT_BUCKET=loadix-documents
LOADIX_MALWARE_SCANNER=

LOADIX_SMTP_HOST=
LOADIX_SMTP_PORT=587
LOADIX_SMTP_FROM_ADDRESS=accounts@example.com
LOADIX_SMTP_USERNAME=
LOADIX_SMTP_PASSWORD=
LOADIX_SMTP_ENABLE_SSL=true
LOADIX_AUTHENTICATION_SIGNING_KEY=
LOADIX_TRUSTED_PROXY_IP=
LOADIX_OTEL_EXPORTER_OTLP_ENDPOINT=
