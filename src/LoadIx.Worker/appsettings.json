{
  "ConnectionStrings": {
    "Database": ""
  },
  "Dependencies": {
    "RedisHost": "",
    "RedisPort": 6380,
    "RabbitMqHost": "",
    "RabbitMqPort": 5671,
    "RabbitMqUsername": "",
    "RabbitMqPassword": "",
    "RabbitMqVirtualHost": "/",
    "RabbitMqUseSsl": true,
    "RabbitMqServerName": "",
    "ReportExportQueueName": "loadix.report-exports",
    "ReportExportDeadLetterQueueName": "loadix.report-exports.dead-letter",
    "ObjectStorageHost": "",
    "ObjectStoragePort": 443,
    "SmtpHost": "",
    "SmtpPort": 587
  },
  "LoadIx": {
    "ServiceName": "LoadIx.Worker",
    "Version": "0.1.0",
    "WebOrigin": "https://pilot.example.invalid",
    "RunBackgroundWorkers": true
  },
  "AccountEmail": {
    "Host": "",
    "Port": 587,
    "FromAddress": "",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },
  "Documents": {
    "Provider": "S3Compatible",
    "Endpoint": "",
    "Bucket": "loadix-documents",
    "UseSsl": true,
    "MaximumSizeMegabytes": 15,
    "PreviewMaximumDimension": 1600,
    "MaximumImagePixels": 40000000,
    "AllowedExtensions": [".pdf", ".jpg", ".jpeg", ".png", ".webp"],
    "MalwareScanner": "Unconfigured"
  },
  "DataProtection": {
    "Provider": "FileSystem",
    "ApplicationName": "LoadIx",
    "KeyRingPath": "/home/app/.aspnet/DataProtection-Keys"
  },
  "EdgeDevices": {
    "TimestampToleranceSeconds": 300,
    "BootstrapLifetimeMinutes": 30,
    "CredentialOverlapMinutes": 15,
    "CredentialCleanupIntervalSeconds": 300,
    "OfflineAfterSeconds": 180,
    "HeartbeatIntervalSeconds": 60,
    "MaximumTicketCharacters": 64000,
    "AuthenticatedRequestPermitLimit": 60,
    "AuthenticatedRequestWindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }
}
