root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_require_accessibility_modifiers = always:suggestion

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[src/**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0161.severity = none

[src/LoadIx.Domain/Common/Result.cs]
# Result<T>.Success/Failure is the conventional, discoverable result factory API.
dotnet_diagnostic.CA1000.severity = none

[src/LoadIx.Application/MasterData/MasterDataContracts.cs]
# MasterDataResult<T> follows the repository's explicit result factory convention.
dotnet_diagnostic.CA1000.severity = none

[src/LoadIx.Application/Contracts/ContractModels.cs]
# ContractResult<T> follows the repository's explicit result factory convention.
dotnet_diagnostic.CA1000.severity = none

[src/LoadIx.Application/Instructions/InstructionModels.cs]
# InstructionResult<T> follows the repository's explicit result factory convention.
dotnet_diagnostic.CA1000.severity = none
