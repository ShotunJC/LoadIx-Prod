{$DEMO_DOMAIN} {
    # Preserve the versioned /api/v1 path expected by ASP.NET Core.
    handle /api/* {
        reverse_proxy api:8080 {
            # Informs ASP.NET Core that the entry request was HTTPS
            header_up X-Forwarded-Proto https
        }
    }

    handle /hubs/* {
        reverse_proxy api:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    # Route all other traffic to the frontend Vite/Web container
    handle {
        reverse_proxy web:8080
    }

    # Optional: Enable Gzip and Zstandard compression
    encode gzip zstd

    # Optional: Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
}
