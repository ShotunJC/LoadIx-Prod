{
    email {$ACME_EMAIL}
}

{$LOADIX_DOMAIN} {
    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }

    reverse_proxy web:8080
}
